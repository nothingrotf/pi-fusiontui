{
  "name": "pi-fusiontui",
  "version": "0.3.0",
  "description": "A Droid/Grok-inspired editor + rich statusline for Pi (folder, branch, context, price, model, effort, 5h & weekly usage).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "statusline",
    "droid",
    "grok"
  ],
  "author": "nothingrotf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nothingrotf/pi-fusiontui.git"
  },
  "homepage": "https://github.com/nothingrotf/pi-fusiontui#readme",
  "bugs": {
    "url": "https://github.com/nothingrotf/pi-fusiontui/issues"
  },
  "files": [
    "extensions",
    "themes"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "check": "bun run lint && bun run typecheck && bun test",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "pi:dev": "${PI_BIN:-pi} --no-extensions -e ./extensions/fusion/index.ts",
    "pi:install-local": "${PI_BIN:-pi} install ./ -l",
    "commitlint": "commitlint --edit",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "semantic-release": "25.0.8",
    "typescript": "^6.0.2"
  }
}
